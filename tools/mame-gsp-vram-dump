#!/usr/bin/env python3
"""Dump the physical 512 KiB GSP VRAM share as consecutive 16-bit words.

tools/mame-gsp-state-snapshot reports vram_high_sum32, which is a stride sweep
of the share. That is the right shape for a checksum and the wrong shape for an
image: it cannot answer "are these bytes identical", which is the question
tools/check-gsp-replay asks when it compares a native board-model replay
against the original machine.

The TMS34010 program space is bit-addressed (`addrshift=3`). A physical 16-bit
word is at address `base + 0x10 * index`; stepping by 2 (the old code) sampled
overlapping bit-address windows and made a 4 MiB file that was incorrectly
called the physical share. The manual's 16 x 64Kx4 VRAM array and MAME's direct
`m_gsp_vram.bytes()` dump both establish a 512 KiB backing share. This tool now
reads 262144 consecutive words at the correct bit-address stride. See findings
section 34.

Zero is valid share content: the boot ROM clears most of VRAM before drawing,
so an all-zero image at an early frame is not a failed read. The nonzero count
is reported as an observation, not used as a success criterion. The per-run
`-nvram_directory` is still set to keep machine state isolated.

The capture is compared against the instrumented MAME direct-share hook in
`reference/experiments/stunrun/gsp-direct-share-frame600-service/`. A direct
memory-share capture is authoritative if it disagrees with this program-space
reader.

Usage:
    tools/mame-gsp-vram-dump roms /tmp/stunrun-oracle \
        --frames 600 --target 600 --input service
"""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors, run_mame
from mame_launch import mame_launch


DUMP = re.compile(
    r"M1_GSP_VRAM frame=(\d+) base=([0-9A-Fa-f]+) words=(\d+) nonzero=(\d+) "
    r"out=(\S+) pc=([0-9A-Fa-f]+)"
)

# Same names and timing as mame-gsp-state-snapshot, so a dump and a state
# snapshot can describe the same machine state.
INPUT_MODES = ("none", "service", "service_probe", "sw_off_prestart", "drive",
               "late", "late_drive", "fork_hold_left", "fork_hold_right",
               "fork_center")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600,
                        help="emulated frames to run (bounds the MAME process)")
    parser.add_argument("--target", type=int, default=600,
                        help="frame to capture the share at")
    parser.add_argument("--words", type=int, default=0x40000,
        help="physical 16-bit words to capture; default 262144 = the whole 512 KiB share")
    parser.add_argument("--input", choices=INPUT_MODES, default="none")
    parser.add_argument("--mame", default="mame")
    parser.add_argument("--nothrottle", action="store_true",
                        help="run MAME as fast as possible while preserving emulated frame numbers")
    parser.add_argument("--windowed", action="store_true",
                        help="run with a visible window instead of the headless video backend")
    parser.add_argument("--isolated-display", action="store_true",
                        help="run SDL on a private Xvfb display, never the physical desktop")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    if args.target <= 0:
        parser.error("--target must be positive")
    if args.words <= 0:
        parser.error("--words must be positive")
    if args.words > 0x40000:
        parser.error("--words cannot exceed 262144: the physical GSP VRAM share is 512 KiB")
    if args.target > args.frames:
        parser.error(f"--target {args.target} is past --frames {args.frames}")

    args.output.mkdir(parents=True, exist_ok=True)
    dump_path = args.output / "gsp_vram.bin"
    log = args.output / "mame.log"
    # cfg, nvram and state all get a fresh per-run directory from
    # tools/mame_launch.py. They used to be `<output>/mame-state`, which is
    # per-CAPTURE rather than per-RUN: two runs into one output directory still
    # shared it. The reason this tool needed -nvram_directory at all is that
    # -nonvram_save stops MAME writing NVRAM but not reading it, so without one
    # a run inherits ~/.mame/nvram/stunrun/ and the share reads as 262144 zero
    # words at exactly the right size.
    environment = {
        **os.environ,
        "STUNRUN_GSP_VRAM_OUT": str(dump_path),
        "STUNRUN_GSP_VRAM_FRAME": str(args.target),
        "STUNRUN_GSP_VRAM_WORDS": str(args.words),
        "STUNRUN_GSP_VRAM_INPUT": args.input,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "x11") if args.windowed else "dummy",
    }
    with mame_launch(mame=args.mame, rompath=args.rompath, frames=args.frames,
                     video="sdl" if args.windowed else "none",
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/gsp-vram-dump.lua",
                     extra=(("-window",) if args.windowed else ())
                     + (("-nothrottle",) if args.nothrottle else ())) as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                                 env=environment, isolated_display=args.isolated_display)
        text = log.read_text(encoding="utf-8")
    match = DUMP.search(text)
    canonical = re.sub(r"out=[^\s]+", "out=<dump>", text)
    result = {
        "schema": "stunrun-gsp-vram-dump-result/v2",
        "frames": args.frames, "target": args.target, "words": args.words,
        "input": args.input, "nothrottle": args.nothrottle,
        "returncode": completed.returncode,
        "lua_errors": find_lua_errors(text),
        "capture": None,
        "dump": str(dump_path),
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    if match:
        result["capture"] = {
            "frame": int(match.group(1)),
            "base": int(match.group(2), 16),
            "words": int(match.group(3)),
            "nonzero_words": int(match.group(4)),
            "pc": int(match.group(6), 16),
        }
    (args.output / "result.json").write_text(
        json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode or match is None:
        raise SystemExit(f"GSP VRAM dump failed; see {log}")
    check_lua_errors(text, log)
    capture = result["capture"]
    if capture["frame"] != args.target:
        raise SystemExit(
            f"captured frame {capture['frame']} but --target was {args.target}; see {log}")
    expected_bytes = args.words * 2
    if not dump_path.is_file():
        raise SystemExit(f"MAME did not produce a VRAM dump: {dump_path}")
    actual_bytes = dump_path.stat().st_size
    if actual_bytes != expected_bytes:
        raise SystemExit(
            f"VRAM dump is {actual_bytes} bytes, expected {expected_bytes} "
            f"({args.words} words); see {log}")
    result["dump_sha256"] = hashlib.sha256(dump_path.read_bytes()).hexdigest()
    (args.output / "result.json").write_text(
        json.dumps(result, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(result, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
