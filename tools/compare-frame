def _build_font(table: str) -> dict[str, tuple[str, ...]]:
    font: dict[str, tuple[str, ...]] = {}
    for line in table.strip().splitlines():
        character, *rows = line.split()
        if len(rows) != GLYPH_H_DECLARED:
            raise CompareError(f"font glyph {character!r} has {len(rows)} rows, expected {GLYPH_H_DECLARED}")
        font[character] = tuple(rows)
    return font


GLYPH_H_DECLARED = 5
GLYPH_W_DECLARED = 3
FONT = _build_font(_FONT_TABLE)
FONT[" "] = ("...", "...", "...", "...", "...")

GLYPH_W, GLYPH_H, GLYPH_GAP = 3, 5, 1


def text_width(text: str) -> int:
    return len(text) * (GLYPH_W + GLYPH_GAP) - GLYPH_GAP if text else 0


def draw_text(rgb: bytearray, width: int, height: int, x: int, y: int, text: str,
              colour: tuple[int, int, int]) -> None:
    """Blit 3x5 uppercase text into an RGB buffer, clipped to the buffer."""
    cursor = x
    for character in text.upper():
        glyph = FONT.get(character)
        if glyph is None:
            glyph = FONT["?"]
        for row in range(GLYPH_H):
            for column in range(GLYPH_W):
                if glyph[row][column] != "#":
                    continue
                px, py = cursor + column, y + row
                if 0 <= px < width and 0 <= py < height:
                    offset = (py * width + px) * 3
                    rgb[offset:offset + 3] = bytes(colour)
        cursor += GLYPH_W + GLYPH_GAP


def draw_label(rgb: bytearray, width: int, height: int, x: int, y: int, text: str) -> None:
    """Draw text on a dark plate so it reads over any picture."""
    box_w, box_h = text_width(text) + 4, GLYPH_H + 4
    for row in range(box_h):
        py = y + row
        if not 0 <= py < height:
            continue
        for column in range(box_w):
            px = x + column
            if 0 <= px < width:
                offset = (py * width + px) * 3
                rgb[offset:offset + 3] = b"\x00\x00\x00"
    draw_text(rgb, width, height, x + 2, y + 2, text, (255, 255, 255))


# --------------------------------------------------------------------------
# Comparison
# --------------------------------------------------------------------------

DENSITY_RAMP = " .:-=+*#%@"


def compare(oracle: bytes, native: bytes, width: int, height: int,
            threshold: int, block: int) -> dict:
    """Per-pixel and per-block difference between two same-size RGB frames."""
    if len(oracle) != len(native):
        raise CompareError(
            f"frame size mismatch: oracle {len(oracle)} RGB bytes, native "
            f"{len(native)}")
    columns = (width + block - 1) // block
    rows = (height + block - 1) // block
    block_changed = [0] * (columns * rows)
    block_pixels = [0] * (columns * rows)
    block_agree_lit = [0] * (columns * rows)
    changed_pixels = 0
    changed_channels = 0
    total_error = 0
    max_error = 0
    agree_black = 0
    agree_lit = 0
    histogram: Counter = Counter()

    for y in range(height):
        block_row = (y // block) * columns
        for x in range(width):
            offset = (y * width + x) * 3
            oread = oracle[offset:offset + 3]
            natread = native[offset:offset + 3]
            cell = block_row + (x // block)
            block_pixels[cell] += 1
            worst = 0
            for channel in range(3):
                delta = abs(oread[channel] - natread[channel])
                if delta > worst:
                    worst = delta
                if delta:
                    changed_channels += 1
                    total_error += delta
                    if delta > max_error:
                        max_error = delta
            histogram[(oread[0] << 16) | (oread[1] << 8) | oread[2]] += 1
            if worst > threshold:
                changed_pixels += 1
                block_changed[cell] += 1
            elif oread[0] | oread[1] | oread[2]:
                # The frames agree here AND something is actually drawn. This
                # is the only agreeing pixel that says anything about the
                # renderer; agreeing on black says nothing at all, and a tool
                # that reports one number for both hides that difference.
                agree_lit += 1
                block_agree_lit[cell] += 1
            else:
                agree_black += 1

    total_pixels = width * height
    block_area = block * block
    grid_changed = []
    grid_fraction = []
    for row in range(rows):
        grid_changed.append(block_changed[row * columns:(row + 1) * columns])
        grid_fraction.append([
            block_changed[row * columns + column] / block_area
            for column in range(columns)
        ])

    worst_blocks = sorted(
        ({"x": index % columns, "y": index // columns,
          "changed_pixels": block_changed[index],
          "block_pixels": block_pixels[index],
          "fraction": block_changed[index] / block_area}
         for index in range(len(block_changed))),
        key=lambda entry: (-entry["changed_pixels"], entry["y"], entry["x"]),
    )[:12]

    # Where, if anywhere, the two frames agree on something actually drawn.
    # Ranked descending so an all-zero list means "nowhere", unambiguously.
    agreeing_lit_blocks = sorted(
        ({"x": index % columns, "y": index // columns,
          "agreeing_lit_pixels": block_agree_lit[index],
          "block_pixels": block_pixels[index],
          "fraction": block_agree_lit[index] / block_area}
         for index in range(len(block_agree_lit)) if block_agree_lit[index]),
        key=lambda entry: (-entry["agreeing_lit_pixels"], entry["y"], entry["x"]),
    )[:12]

    return {
        "width": width,
        "height": height,
        "total_pixels": total_pixels,
        "threshold": threshold,
        "changed_pixels": changed_pixels,
        "changed_pixel_fraction": changed_pixels / total_pixels if total_pixels else 0.0,
        "changed_channels": changed_channels,
        "max_abs_error": max_error,
        "mean_abs_error": total_error / (total_pixels * 3) if total_pixels else 0.0,
        "identical": changed_pixels == 0,
        "agreeing_pixels": total_pixels - changed_pixels,
        "agreeing_both_black_pixels": agree_black,
        "agreeing_lit_pixels": agree_lit,
        "oracle_colours": len(histogram),
        "block_size": block,
        "block_grid": [columns, rows],
        "block_changed": grid_changed,
        "block_fraction": grid_fraction,
        "block_agreeing_lit": [block_agree_lit[row * columns:(row + 1) * columns]
                               for row in range(rows)],
        "worst_blocks": worst_blocks,
        "agreeing_lit_blocks": agreeing_lit_blocks,
    }


def ascii_block_map(result: dict) -> str:
    """Density as text, so the answer survives a terminal with no image viewer."""
    grid = result["block_fraction"]
    lines = []
    for row in grid:
        line = []
        for fraction in row:
            if fraction <= 0.0:
                line.append(" ")
                continue
            step = min(len(DENSITY_RAMP) - 1, max(1, int(fraction * len(DENSITY_RAMP))))
            line.append(DENSITY_RAMP[step])
        lines.append("".join(line))
    return "\n".join(lines)


def make_diff(rgb_a: bytes, rgb_b: bytes, width: int, height: int,
              gain: int) -> bytes:
    """Amplified absolute per-channel difference. Black == no difference."""
    out = bytearray(len(rgb_a))
    for index in range(len(rgb_a)):
        delta = abs(rgb_a[index] - rgb_b[index]) * gain
        out[index] = 255 if delta > 255 else delta
    return bytes(out)


def heatmap(values: list[list[float]], block: int, width: int, height: int,
            columns: int, rows: int) -> tuple[bytearray, int, int]:
    """Render a density grid as colour, one cell per block. Returns (rgb, w, h)."""
    cell_w, cell_h = max(1, width // columns), max(1, height // rows)
    out_w, out_h = cell_w * columns, cell_h * rows
    out = bytearray(out_w * out_h * 3)
    for row in range(rows):
        for column in range(columns):
            fraction = values[row][column]
            # 0 -> deep blue, 0.5 -> green, 1 -> yellow/red. Perceptually ordered
            # so "hot" reads as "disagrees" without consulting the legend.
            red = int(255 * min(1.0, max(0.0, (fraction - 0.5) * 2.0)))
            green = int(255 * min(1.0, fraction * 2.0))
            blue = int(255 * max(0.0, 1.0 - fraction * 2.0))
            colour = bytes((red, green, blue))
            for py in range(row * cell_h, (row + 1) * cell_h):
                start = (py * out_w + column * cell_w) * 3
                out[start:start + cell_w * 3] = colour * cell_w
    return out, out_w, out_h


def make_side_by_side(oracle: bytes, native: bytes, width: int, height: int,
                      gap: int, frame: int) -> tuple[bytes, int, int]:
    out_w = width * 2 + gap
    out = bytearray(out_w * height * 3)
    for row in range(height):
        source = row * width * 3
        target = row * out_w * 3
        out[target:target + width * 3] = oracle[source:source + width * 3]
        middle = target + width * 3
        out[middle:middle + gap * 3] = b"\xff\xff\xff" * gap
        right = middle + gap * 3
        out[right:right + width * 3] = native[source:source + width * 3]
    draw_label(out, out_w, height, 4, 4, "ORACLE")
    draw_label(out, out_w, height, width + gap + 4, 4, "NATIVE")
    draw_label(out, out_w, height, 4, height - 11, f"F{frame}")
    return bytes(out), out_w, height


