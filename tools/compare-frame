class CompareError(RuntimeError):
    """A comparison that cannot be made honestly. Never silently degraded."""


# --------------------------------------------------------------------------
# PNG decode / encode. No PIL and no numpy in this environment, and the house
# style (tools/gsp_render.py) already writes PNGs with zlib directly.
# --------------------------------------------------------------------------

def decode_png(path: pathlib.Path) -> tuple[int, int, bytes]:
    """Return (width, height, packed RGB bytes) for an 8-bit non-interlaced PNG.

    Accepts colour type 2 (RGB) and 6 (RGBA) only. Anything else is rejected
    loudly: a reader that silently mis-decodes a 16-bit or palette PNG invents
    a plausible frame and every number derived from it becomes fiction.
    """
    data = path.read_bytes()
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        raise CompareError(f"{path}: not a PNG (bad signature)")
    width = height = depth = colour = interlace = None
    idat = bytearray()
    offset = 8
    while offset < len(data):
        if offset + 8 > len(data):
            raise CompareError(f"{path}: truncated PNG chunk header at {offset}")
        size = struct.unpack_from(">I", data, offset)[0]
        kind = data[offset + 4:offset + 8]
        payload = data[offset + 8:offset + 8 + size]
        if offset + 8 + size > len(data):
            raise CompareError(f"{path}: truncated PNG {kind.decode()} chunk")
        if kind == b"IHDR":
            width, height, depth, colour, _, _, interlace = struct.unpack(">IIBBBBB", payload)
        elif kind == b"IDAT":
            idat += payload
        offset += size + 12
    if width is None or not idat:
        raise CompareError(f"{path}: PNG has no IHDR or no IDAT")
    if depth != 8 or interlace != 0 or colour not in (2, 6):
        raise CompareError(
            f"{path}: unsupported PNG (depth={depth} colour_type={colour} "
            f"interlace={interlace}); need depth 8, colour_type 2 or 6, "
            f"interlace 0")
    channels = 3 if colour == 2 else 4
    stride = width * channels
    raw = zlib.decompress(bytes(idat))
    if len(raw) != (stride + 1) * height:
        raise CompareError(
            f"{path}: PNG pixel data is {len(raw)} bytes, expected "
            f"{(stride + 1) * height} for {width}x{height} ({channels} channels)")
    out = bytearray(width * height * 3)
    previous = bytearray(stride)
    position = 0
    for row in range(height):
        method = raw[position]
        position += 1
        line = bytearray(raw[position:position + stride])
        position += stride
        if method == 1:
            for index in range(channels, stride):
                line[index] = (line[index] + line[index - channels]) & 0xFF
        elif method == 2:
            for index in range(stride):
                line[index] = (line[index] + previous[index]) & 0xFF
        elif method == 3:
            for index in range(stride):
                left = line[index - channels] if index >= channels else 0
                line[index] = (line[index] + ((left + previous[index]) >> 1)) & 0xFF
        elif method == 4:
            for index in range(stride):
                left = line[index - channels] if index >= channels else 0
                up = previous[index]
                upleft = previous[index - channels] if index >= channels else 0
                estimate = left + up - upleft
                da, db, dc = abs(estimate - left), abs(estimate - up), abs(estimate - upleft)
                if da <= db and da <= dc:
                    predictor = left
                elif db <= dc:
                    predictor = up
                else:
                    predictor = upleft
                line[index] = (line[index] + predictor) & 0xFF
        elif method != 0:
            raise CompareError(f"{path}: unknown PNG filter method {method} on row {row}")
        if channels == 4:
            for column in range(width):
                source = column * 4
                target = (row * width + column) * 3
                out[target:target + 3] = line[source:source + 3]
        else:
            out[row * stride:(row + 1) * stride] = line
        previous = line
    return width, height, bytes(out)


def encode_png(path: pathlib.Path, width: int, height: int, rgb: bytes) -> None:
    """Write an 8-bit colour-type-2 (truecolour) PNG."""
    if len(rgb) != width * height * 3:
        raise CompareError(
            f"{path}: refusing to write {len(rgb)} RGB bytes for {width}x{height} "
            f"(expected {width * height * 3})")
    raw = bytearray()
    stride = width * 3
    for row in range(height):
        raw.append(0)
        raw += rgb[row * stride:(row + 1) * stride]

    def chunk(tag: bytes, payload: bytes) -> bytes:
        return (struct.pack(">I", len(payload)) + tag + payload
                + struct.pack(">I", zlib.crc32(tag + payload) & 0xFFFFFFFF))

    blob = b"\x89PNG\r\n\x1a\n"
    blob += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
    blob += chunk(b"IDAT", zlib.compress(bytes(raw), 6))
    blob += chunk(b"IEND", b"")
    path.write_bytes(blob)


