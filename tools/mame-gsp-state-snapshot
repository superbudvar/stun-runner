#!/usr/bin/env python3
"""Capture low-rate GSP state samples at bounded frame landmarks."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import tempfile

import sys
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors, run_mame
from mame_launch import mame_launch


SNAPSHOT = re.compile(
    r"M1_GSP_STATE frame=(\d+) pc=([0-9A-Fa-f]+) st=([0-9A-Fa-f]+) "
    r"lo_sum=(\d+) hi_sum=(\d+) low_sum=(\d+) high_sum=(\d+)"
)
CONTROL = re.compile(r"M1_GSP_CONTROL frame=(\d+) lo=([^\r\n ]*) hi=([^\r\n ]*)")
DISPLAY = re.compile(
    r"M1_GSP_DISPLAY frame=(\d+) dpyadr=(\S+) dpytap=(\S+) "
    r"dpystart=(\S+) heblnk=(\S+) hsblnk=(\S+) dpyctl=(\S+) "
    r"fine_scroll=(\S+)"
)
SCREEN = re.compile(r"M1_GSP_SCREEN frame=(\d+) path=(.+)")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=1800)
    parser.add_argument("--targets", default="600,1800")
    parser.add_argument("--input", choices=("none", "service", "service_probe", "sw_off_prestart", "drive", "late", "late_drive", "fork_hold_left", "fork_hold_right", "fork_center"), default="none")
    parser.add_argument("--mame", default="mame")
    parser.add_argument("--load-state", type=pathlib.Path,
                        help="load a MAME state before starting the relative frame counter")
    parser.add_argument("--nothrottle", action="store_true",
                        help="run MAME as fast as possible while preserving emulated frame numbers")
    parser.add_argument("--windowed", action="store_true",
                        help="run with a visible window instead of the headless video backend")
    parser.add_argument("--isolated-display", action="store_true",
                        help="run SDL on a private Xvfb display, never the physical desktop")
    parser.add_argument("--detail", action="store_true",
                        help="also record nonzero GSP control-register words")
    parser.add_argument("--screen", type=pathlib.Path,
                        help="save the exact MAME screen at each requested frame")
    parser.add_argument("--screen-dir", type=pathlib.Path,
                        help="save one PNG per requested frame as frame-NNNNNN.png")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    if args.screen and args.screen_dir:
        parser.error("--screen and --screen-dir are mutually exclusive")
    if args.screen_dir:
        args.screen_dir.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    if args.load_state and not args.load_state.is_file():
        raise SystemExit(f"save state does not exist: {args.load_state}")
    # This tool had THREE isolation defects that made it describe a different
    # machine than its sibling mame-gsp-vram-dump, which was already correct:
    #
    #   1. -cfg_directory pointed at a SHARED hardcoded /tmp/stunrun-mame-cfg.
    #      MAME writes stunrun.cfg there at exit INCLUDING current DIP state,
    #      and -noreadconfig does not stop the next run reading it back, so a
    #      run that touched an input port silently changed every later run.
    #      The same bug was fixed in mame-memory-snapshot (findings section 74)
    #      and was still live here.
    #   2. -nonvram_save was passed WITHOUT -nvram_directory. -nonvram_save
    #      stops MAME *writing* NVRAM; it does not stop it *loading*. This tool
    #      therefore read the repository's stale gitignored nvram/stunrun/ and
    #      booted with a previous session's state -- which is why frame 400
    #      showed a title screen instead of the real cold-boot "DOWNLOADING GSP".
    #   3. -state_directory was a shared /tmp/stunrun-state-dir, so a
    #      --load-state run could see another run's slots.
    #
    # Fixing all three is what makes this tool's frame numbers mean the same
    # thing as mame-gsp-vram-dump's. See findings section 80.
    #
    # It then moved all three to `<output>/mame-state`, which is per-CAPTURE
    # rather than per-RUN: two runs into one output directory still shared it.
    # tools/mame_launch.py now supplies a fresh directory per run for cfg,
    # nvram and state. Only the staged --load-state slot stays under
    # `<output>/mame-state`, because that one is a staged INPUT the operator
    # may want to look at, and the caller keeps ownership of it.
    state_directory = None
    if args.load_state:
        run_dir = args.output / "mame-state"
        run_dir.mkdir(parents=True, exist_ok=True)
        slot_directory = run_dir / "stunrun"
        slot_directory.mkdir()
        shutil.copy2(args.load_state, slot_directory / "1.sta")
        state_directory = run_dir
    extra: list[str] = []
    if args.load_state:
        extra += ["-state", "1"]
    if args.nothrottle:
        extra.append("-nothrottle")
    environment = {
        **os.environ,
        "STUNRUN_GSP_STATE_OUT": str(args.output),
        "STUNRUN_GSP_STATE_FRAMES": str(args.frames),
        "STUNRUN_GSP_STATE_TARGETS": args.targets,
        "STUNRUN_GSP_STATE_INPUT": args.input,
        "STUNRUN_GSP_STATE_DETAIL": "1" if args.detail else "0",
        "STUNRUN_GSP_STATE_SCREEN": str(args.screen) if args.screen else "",
        "STUNRUN_GSP_STATE_SCREEN_DIR": str(args.screen_dir) if args.screen_dir else "",
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "x11") if args.windowed else "dummy",
    }
    with mame_launch(mame=args.mame, rompath=args.rompath,
                     seconds=86400 if args.load_state else None,
                     frames=args.frames,
                     state_directory=state_directory,
                     video="sdl" if args.windowed else "none",
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/gsp-state-snapshot.lua",
                     extra=tuple(extra) + (("-window",) if args.windowed else ())) as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                                 env=environment, isolated_display=args.isolated_display)
        text = log.read_text(encoding="utf-8")
    snapshots = [
        {"frame": int(match.group(1)), "pc": int(match.group(2), 16),
         "st": int(match.group(3), 16), "control_lo_sum32": int(match.group(4)),
         "control_hi_sum32": int(match.group(5)), "vram_low_sum32": int(match.group(6)),
         "vram_high_sum32": int(match.group(7))}
        for match in SNAPSHOT.finditer(text)
    ]
    controls = {
        int(match.group(1)): {
            "lo": match.group(2), "hi": match.group(3)
        }
        for match in CONTROL.finditer(text)
    }
    displays = {
        int(match.group(1)): {
            "dpyadr": None if match.group(2) == "nil" else int(match.group(2)),
            "dpytap": None if match.group(3) == "nil" else int(match.group(3)),
            "dpystart": None if match.group(4) == "nil" else int(match.group(4)),
            "heblnk": None if match.group(5) == "nil" else int(match.group(5)),
            "hsblnk": None if match.group(6) == "nil" else int(match.group(6)),
            "dpyctl": None if match.group(7) == "nil" else int(match.group(7)),
            "fine_scroll": None if match.group(8) == "nil" else int(match.group(8)),
        }
        for match in DISPLAY.finditer(text)
    }
    screens = {
        int(match.group(1)): match.group(2)
        for match in SCREEN.finditer(text)
    }
    for snapshot in snapshots:
        if snapshot["frame"] in controls:
            snapshot["control_nonzero"] = controls[snapshot["frame"]]
        if snapshot["frame"] in displays:
            snapshot["display"] = displays[snapshot["frame"]]
        if snapshot["frame"] in screens:
            snapshot["screen"] = screens[snapshot["frame"]]
    canonical = re.sub(r"output=[^\n]+", "output=<output>", text)
    lua_errors = find_lua_errors(text)
    result = {
        "schema": "stunrun-gsp-state-snapshot-result/v1",
        "frames": args.frames, "targets": args.targets, "input": args.input,
        "load_state": str(args.load_state) if args.load_state else None,
        "nothrottle": args.nothrottle,
        "returncode": completed.returncode, "snapshots": snapshots,
        "lua_errors": lua_errors,
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    # Written before the check so the diagnosis has an artifact to point at.
    check_lua_errors(text, log)
    if completed.returncode or len(snapshots) != len(args.targets.split(',')):
        raise SystemExit(f"GSP state snapshot failed; see {log}")
    if args.screen and not args.screen.is_file():
        raise SystemExit(f"MAME did not produce screen snapshot: {args.screen}")
    if args.screen_dir:
        expected = [args.screen_dir / f"frame-{int(target):06d}.png"
                    for target in args.targets.split(",")]
        missing = [str(path) for path in expected if not path.is_file()]
        if missing:
            raise SystemExit(f"MAME did not produce screen snapshots: {', '.join(missing)}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
