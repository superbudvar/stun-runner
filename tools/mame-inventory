#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: $0 ROMPATH [MAME_EXE]" >&2
    exit 2
}

[[ $# -ge 1 && $# -le 2 ]] || usage
rompath=$1
mame_exe=${2:-mame}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
log_file=$(mktemp /tmp/stunrun-inventory.XXXXXX)
trap 'rm -f "$log_file"' EXIT

# The MAME invocation goes through tools/mame_launch.py so this shell wrapper
# cannot be the place an isolation flag is spelled a seventh way. The wrapper
# has no Python of its own, so it calls python3 once; the cfg/nvram/state
# directories are per-run and removed by the launcher, which is what stops one
# run reading the previous run's stunrun.cfg (AGENTS.md trap 12). MAME's stdout
# stays in the temp log exactly as before.
python3 - "$repo_dir" "$rompath" "$mame_exe" "$log_file" <<'PY'
import pathlib
import subprocess
import sys

sys.path.insert(0, sys.argv[1])
sys.path.insert(0, str(pathlib.Path(sys.argv[1]) / "tools"))
from mame_launch import mame_launch
from mame_harness.process import run_mame

rompath, mame_exe, log_file = sys.argv[2], sys.argv[3], sys.argv[4]
# -seconds_to_run 2 is this tool's own bound: inventory.lua prints its JSON and
# calls machine:exit(), and two seconds covers a cold MAME start.
with mame_launch(mame=mame_exe, rompath=rompath, seconds=2,
                 autoboot=pathlib.Path(sys.argv[1]) / "mame" / "lua" / "inventory.lua") as launch:
    with pathlib.Path(log_file).open("w", encoding="utf-8") as handle:
        status = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT)
# `set -e` used to abort on a nonzero MAME exit. run_mame does not raise, so the
# code is passed out explicitly or a dead emulator reads as a clean run.
sys.exit(status.returncode)
PY

# MAME reports a failed `-autoboot_script` as a line in its own output and then
# carries on, exiting 0, so `set -e` above never sees it. The inventory script
# prints its JSON and calls machine:exit(), so a script that dies partway
# through -- or one that printed JSON and then threw -- still leaves something
# to extract, and a device missing from that partial list reads as a fact about
# the machine rather than about the observer. The decision belongs to every
# wrapper and lives in mame_harness/process.py; this shell wrapper has no Python
# of its own and calls it once.
#
# stdout is the inventory itself, so the recorded errors go to stderr rather
# than corrupting the JSON document.
check_lua_log() {
    python3 - "$repo_dir" "$log_file" <<'PY'
import json
import pathlib
import sys

sys.path.insert(0, sys.argv[1])
from mame_harness.process import check_lua_errors, find_lua_errors

log = pathlib.Path(sys.argv[2])
text = log.read_text(encoding="utf-8", errors="replace")
print("lua_errors: " + json.dumps(find_lua_errors(text)), file=sys.stderr)
check_lua_errors(text, log)
PY
}

# The log is a temp file the EXIT trap removes, so a failure dumps it here,
# before that trap runs, rather than citing a path that is already gone.
check_lua_log || {
    cat "$log_file" >&2
    echo "MAME's Lua script failed; the inventory is incomplete" >&2
    exit 1
}

json=$(sed -n 's/^MAME_INVENTORY_JSON //p' "$log_file")
[[ -n "$json" ]] || {
    cat "$log_file" >&2
    echo "inventory script produced no JSON" >&2
    exit 1
}
printf '%s\n' "$json"
