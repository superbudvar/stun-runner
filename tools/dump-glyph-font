#!/usr/bin/env python3
"""Render the MC68010 $1FBC nibble font as a labelled PNG.

The tempting but wrong interpretation is eight 1bpp bytes per glyph. The ROM
stores eight big-endian 16-bit row words in a 16-byte glyph slot. The text loop
consumes the low four nibbles, low-to-high, as four pixels; the upper four
nibbles are zero. This is the MC68010's 4x8 font, not the separate GSP 8x8
glyph-table format used by the native HUD renderer.

ROM_LOAD16_BYTE interleaving is honored: even ROM byte i goes to CPU address
2*i and odd ROM byte i to 2*i+1. The PNG uses white for any nonzero nibble,
black for zero; color-plane selection is intentionally not modeled.

Usage: tools/dump-glyph-font [--roms DIR] [--output PNG] [--chars A-Z|digits|full]
"""

import argparse
import json
import pathlib
import struct
import sys
import zlib

REPO = pathlib.Path(__file__).resolve().parents[1]
CPU_REGION = "mainpcb:maincpu"
FONT_BASE = 0x1FBC
GLYPH_STRIDE = 16
FIRST_CODE = 0x2A
LAST_CODE = 0x155

# Compact 3x5 labels so glyphs remain identifiable in the PNG without a font
# dependency. Each row is encoded left-to-right in the low three bits.
LABELS = {
    "A": (2, 5, 7, 5, 5), "B": (6, 5, 6, 5, 6), "C": (3, 4, 4, 4, 3),
    "D": (6, 5, 5, 5, 6), "E": (7, 4, 6, 4, 7), "F": (7, 4, 6, 4, 4),
    "G": (3, 4, 5, 5, 3), "H": (5, 5, 7, 5, 5), "I": (7, 2, 2, 2, 7),
    "J": (1, 1, 1, 5, 2), "K": (5, 5, 6, 5, 5), "L": (4, 4, 4, 4, 7),
    "M": (5, 7, 7, 5, 5), "N": (5, 7, 7, 7, 5), "O": (2, 5, 5, 5, 2),
    "P": (6, 5, 6, 4, 4), "Q": (2, 5, 5, 3, 1), "R": (6, 5, 6, 5, 5),
    "S": (3, 4, 2, 1, 6), "T": (7, 2, 2, 2, 2), "U": (5, 5, 5, 5, 7),
    "V": (5, 5, 5, 5, 2), "W": (5, 5, 7, 7, 5), "X": (5, 5, 2, 5, 5),
    "Y": (5, 5, 2, 2, 2), "Z": (7, 1, 2, 4, 7),
    "0": (7, 5, 5, 5, 7), "1": (2, 6, 2, 2, 7), "2": (6, 1, 2, 4, 7),
    "3": (6, 1, 2, 1, 6), "4": (5, 5, 7, 1, 1), "5": (7, 4, 6, 1, 6),
    "6": (3, 4, 6, 5, 2), "7": (7, 1, 2, 2, 2), "8": (2, 5, 2, 5, 2),
    "9": (2, 5, 3, 1, 6), "-": (0, 0, 7, 0, 0), "$": (2, 7, 6, 3, 2),
}


def load_rom_image(roms_dir: pathlib.Path, manifest_path: pathlib.Path) -> bytes:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("schema") != "stunrun-rom-manifest/v1":
        raise ValueError(f"unsupported ROM manifest schema in {manifest_path}")
    entries = [r for r in manifest.get("roms", []) if r.get("region") == CPU_REGION]
    by_offset = {r.get("offset"): r for r in entries}
    if not entries or any(not isinstance(offset, int) for offset in by_offset):
        raise ValueError(f"manifest has no valid {CPU_REGION} ROM entries")

    image = bytearray(max(r["offset"] + 2 * r["size"] for r in entries))
    even_offsets = sorted(offset for offset in by_offset if offset % 2 == 0)
    for base in even_offsets:
        even_entry = by_offset[base]
        odd_entry = by_offset.get(base + 1)
        if odd_entry is None:
            raise ValueError(f"missing odd ROM partner at CPU offset 0x{base + 1:X}")
        even_path = roms_dir / even_entry["filename"]
        odd_path = roms_dir / odd_entry["filename"]
        even, odd = even_path.read_bytes(), odd_path.read_bytes()
        if len(even) != even_entry["size"] or len(odd) != odd_entry["size"]:
            raise ValueError(
                f"ROM size mismatch for pair {even_path.name}/{odd_path.name}: "
                f"got {len(even)}/{len(odd)}, expected "
                f"{even_entry['size']}/{odd_entry['size']} bytes"
            )
        if len(even) != len(odd):
            raise ValueError(f"interleaved ROM pair has unequal lengths: {even_path}, {odd_path}")
        image[base:base + 2 * len(even):2] = even
        image[base + 1:base + 2 * len(odd):2] = odd
    return bytes(image)


def glyph_words(image: bytes, code: int) -> tuple[int, list[int]]:
    if not FIRST_CODE <= code <= LAST_CODE:
        raise ValueError(f"character code 0x{code:X} is outside the ROM font window")
    address = FONT_BASE + GLYPH_STRIDE * (code - FIRST_CODE)
    if address + GLYPH_STRIDE > len(image):
        raise ValueError(f"font data for 0x{code:02X} at 0x{address:X} is outside the ROM image")
    words = [int.from_bytes(image[address + 2 * row:address + 2 * row + 2], "big")
             for row in range(8)]
    return address, words


def _chunk(kind: bytes, data: bytes) -> bytes:
    return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)


def write_png(path: pathlib.Path, rgb_rows: list[bytearray], width: int) -> None:
    raw = b"".join(b"\x00" + bytes(row) for row in rgb_rows)
    height = len(rgb_rows)
    png = (b"\x89PNG\r\n\x1a\n" +
           _chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) +
           _chunk(b"IDAT", zlib.compress(raw, 9)) + _chunk(b"IEND", b""))
    path.write_bytes(png)


def render(image: bytes, codes: list[int], pixel_size: int) -> tuple[int, list[bytearray], list[dict]]:
    columns = 10
    cell_width = 6 * pixel_size
    cell_height = 14 * pixel_size
    rows = (len(codes) + columns - 1) // columns
    width, height = columns * cell_width, rows * cell_height
    pixels = [bytearray(width * 3) for _ in range(height)]
    output = []
    for index, code in enumerate(codes):
        address, words = glyph_words(image, code)
        label = chr(code) if 0x20 <= code <= 0x7E else f"${code:02X}"
        col, row = index % columns, index // columns
        x0, y0 = col * cell_width, row * cell_height
        label_text = label.upper()
        label_width = len(label_text) * 4 - 1
        label_x = x0 + max(0, (6 - label_width) // 2) * pixel_size
        for li, char in enumerate(label_text):
            pattern = LABELS.get(char)
            if pattern is None:
                continue
            for ly, mask in enumerate(pattern):
                for lx in range(3):
                    if mask & (1 << (2 - lx)):
                        for dy in range(pixel_size):
                            py = y0 + ly * pixel_size + dy
                            for dx in range(pixel_size):
                                px = label_x + (li * 4 + lx) * pixel_size + dx
                                at = px * 3
                                pixels[py][at:at + 3] = b"\x80\x80\x80"
        gx = x0 + pixel_size
        gy = y0 + 6 * pixel_size
        for y, word in enumerate(words):
            for x in range(4):
                nibble = (word >> (4 * x)) & 0xF
                if nibble:
                    for dy in range(pixel_size):
                        py = gy + y * pixel_size + dy
                        for dx in range(pixel_size):
                            px = gx + x * pixel_size + dx
                            at = px * 3
                            pixels[py][at:at + 3] = b"\xff\xff\xff"
        output.append({"char": label, "code": code, "rom_address": address,
                       "row_words": words,
                       "pixels": [[(word >> (4 * x)) & 0xF for x in range(4)]
                                  for word in words]})
    return width, pixels, output


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--roms", type=pathlib.Path, default=REPO / "roms/stunrun",
                        help="directory containing the MC68010 ROM chips")
    parser.add_argument("--manifest", type=pathlib.Path,
                        default=REPO / "roms/stunrun.manifest.json")
    parser.add_argument("--output", type=pathlib.Path, default=pathlib.Path("glyph-font.png"))
    parser.add_argument("--chars", default="A-Z",
                        help="A-Z (default), digits, full, or a literal string")
    parser.add_argument("--pixel-size", type=int, default=8,
                        help="output pixels per ROM pixel (default: 8)")
    parser.add_argument("--json", action="store_true",
                        help="emit glyph words and metadata as stunrun-glyph-font-v1 JSON")
    args = parser.parse_args()
    if args.pixel_size < 1 or args.pixel_size > 64:
        parser.error("--pixel-size must be between 1 and 64")
    selector = args.chars.upper()
    if selector == "A-Z":
        codes = list(range(ord("A"), ord("Z") + 1))
    elif selector == "DIGITS":
        codes = list(range(ord("0"), ord("9") + 1))
    elif selector == "FULL":
        codes = list(range(FIRST_CODE, LAST_CODE + 1))
    else:
        codes = [ord(char) for char in args.chars]
        if not codes:
            parser.error("--chars must select at least one character")
    try:
        image = load_rom_image(args.roms, args.manifest)
        width, pixels, glyphs = render(image, codes, args.pixel_size)
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as exc:
        parser.error(str(exc))
    write_png(args.output, pixels, width)
    if args.json:
        print(json.dumps({"schema": "stunrun-glyph-font-v1", "font_base": FONT_BASE,
                          "glyph_width": 4, "glyph_height": 8, "pixel_order": "low-nibble-first",
                          "png": str(args.output), "glyphs": glyphs}, indent=2))
    else:
        print(f"wrote {args.output} ({len(codes)} glyphs, {width}x{len(pixels)}, "
              "ROM 4x8 nibble font)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
