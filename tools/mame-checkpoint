#!/usr/bin/env python3
"""Capture a bounded canonical MAME checkpoint."""

import argparse
import json
import math
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors
from mame_launch import mame_launch


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--input", choices=("none", "sw_off", "sw_off_prestart", "drive", "late", "late_drive"), default="none")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    # This tool's bound has always been max(2, ceil((frames + 60) / 60)), which
    # is NOT the shared seconds_for_frames: it rounds up on frames+60 rather
    # than frames, so it grants one second more headroom at every frame count.
    # Preserved verbatim -- see tools/mame_launch.py.
    environment = {**os.environ, "STUNRUN_CHECKPOINT_FRAME": str(args.frames),
                   "STUNRUN_CHECKPOINT_INPUT": args.input,
                   "STUNRUN_CHECKPOINT_OUTPUT_DIR": str(args.output),
                   "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy")}
    # -video soft, not none: checkpoint.lua renders the frame into a PNG, and
    # with no video driver there is nothing to render.
    with mame_launch(mame=args.mame, rompath=args.rompath,
                     seconds=max(2, math.ceil((args.frames + 60) / 60)),
                     video="soft",
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/checkpoint.lua") as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                                       env=environment, check=False)
        text = log.read_text(encoding="utf-8")
    matches = re.findall(r"^MAME_CHECKPOINT_JSON (\{.*\})$", text, re.MULTILINE)
    # MAME reports a failed `-autoboot_script` as a line in its own output and
    # then carries on, exiting 0, so a checkpoint whose script died still
    # produces a document -- and a processor state that never got written reads
    # as a fact about the machine rather than about the observer.
    #
    # The recorded errors go on the summary line rather than into state.json:
    # that file is the `stunrun-checkpoint/v1` document the native emitter is
    # checked against byte for byte (tests/test_checkpoint_golden.py) and it is
    # published as oracle evidence, so its shape is not ours to extend. Record
    # before the failure branch so both paths show it, and keep the document
    # itself the last line of stdout.
    lua_errors = find_lua_errors(text)
    print("lua_errors: " + json.dumps(lua_errors, separators=(",", ":")))
    if completed.returncode or not matches:
        raise SystemExit(f"MAME checkpoint failed; see {log}")
    state = json.loads(matches[-1])
    (args.output / "state.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(state, separators=(",", ":")))
    check_lua_errors(text, log)


if __name__ == "__main__":
    main()
