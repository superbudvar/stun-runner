#!/usr/bin/env python3
"""Capture one no-input ADSP SOMLATCH->GINT transaction in MAME.

Answers: "what words did the ADSP put on SOMLATCH before this GINT, what DM
reads/writes and PM program-space reads surrounded it, and which 68010 bank was
selected?" Captures ADSP DM, same-run PM reads, and 68010 SOM-window/control/FIFO
accesses in one MAME run. An optional NVRAM seed is copied into a disposable
per-run directory to reproduce a known startup state without modifying it.

WHAT IT GETS WRONG: one frame can contain multiple unrelated ADSP routines; a
SOMCLK->GINT interval is an observed transport boundary, not proof that all
preceding DM or PM reads caused every SOM word. The PM tap reports program-space
read values, not decoded operand roles. The host bank is reconstructed from the
68010's address-decoded control writes using the pinned MAME rule. This does not
decode F1 geometry fields or claim a screen-space meaning.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors, run_mame
from mame_launch import mame_launch


EVENT = re.compile(
    r"M1_ADSP_TX_EVENT seq=(\d+) frame=(\d+) cpu=(\w+) access=([RW]) "
    r"address=([0-9A-Fa-f]+) data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+) "
    r"pc=([0-9A-Fa-f]+) bank=(\d+)(?: regs=([A-Za-z0-9:,]+))?"
)
BANK = re.compile(
    r"M1_ADSP_TX_BANK seq=(\d+) frame=(\d+) address=([0-9A-Fa-f]+) "
    r"offset=([0-9A-Fa-f]+) bank=(\d+) pc=([0-9A-Fa-f]+)"
)
STATE = re.compile(
    r"M1_ADSP_TX_STATE record=(\d+) frame=(\d+) i1=(\d+) i2=(\d+) "
    r"m1=(\d+) m2=(\d+) dm=([0-9A-Fa-f]+)\.\.([0-9A-Fa-f]+) words=([0-9A-Fa-f,]+)"
)
DONE = re.compile(
    r"M1_ADSP_TX_DONE frames=(\d+) events=(\d+) truncated=(true|false) "
    r"bank_events=(\d+) tx_start_frame=(nil|\d+) tx_start_seq=(nil|\d+) "
    r"tx_end_frame=(nil|\d+) tx_end_seq=(nil|\d+) records=(\d+)"
)


def sha256(path: pathlib.Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def directory_hashes(root: pathlib.Path) -> dict[str, str]:
    return {
        path.relative_to(root).as_posix(): sha256(path)
        for path in sorted(root.rglob("*")) if path.is_file()
    }


def parse_event(m: re.Match[str]) -> dict[str, object]:
    event = {
        "seq": int(m.group(1)), "frame": int(m.group(2)),
        "cpu": m.group(3), "access": m.group(4),
        "address": int(m.group(5), 16), "data": int(m.group(6), 16),
        "mask": int(m.group(7), 16), "pc": int(m.group(8), 16),
        "host_bank": int(m.group(9)),
    }
    if m.group(10):
        event["registers"] = {
            name: int(value, 16)
            for name, value in (part.split(":", 1) for part in m.group(10).split(","))
        }
    return event


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600,
                        help="bounded power-on run length (default: 600)")
    parser.add_argument("--start-frame", type=int, default=1,
                        help="begin searching for SOMCLK at this frame")
    parser.add_argument("--post-frames", type=int, default=5,
                        help="capture the 68010 ferry this many frames after GINT")
    parser.add_argument("--max-events", type=int, default=50000)
    parser.add_argument("--timeout", type=float, default=180.0)
    parser.add_argument(
        "--nvram-seed", type=pathlib.Path,
        help="copy this NVRAM root (containing stunrun/) into a disposable per-run directory")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames < 2 or not (1 <= args.start_frame < args.frames) or \
            args.post_frames < 0 or args.max_events <= 0:
        parser.error("require frames>=2, 1<=start-frame<frames, post-frames>=0, max-events>0")
    rompath = args.rompath.resolve()
    manifest = rompath / "stunrun.manifest.json"
    if not manifest.is_file():
        raise SystemExit(f"missing ROM manifest: {manifest}")
    mame = pathlib.Path(args.mame)
    if not mame.is_file():
        found = shutil.which(args.mame)
        if found is None:
            raise SystemExit(f"MAME executable not found: {args.mame}")
        mame = pathlib.Path(found)
    mame = mame.resolve()

    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    last_frame = args.frames
    script = pathlib.Path(__file__).resolve().parents[1] / "mame/lua/adsp-som-transaction.lua"
    environment = {
        **os.environ,
        "STUNRUN_ADSP_TX_OUT": str(args.output.resolve()),
        "STUNRUN_ADSP_TX_FIRST": str(args.start_frame),
        "STUNRUN_ADSP_TX_LAST": str(last_frame),
        "STUNRUN_ADSP_TX_POST_FRAMES": str(args.post_frames),
        "STUNRUN_ADSP_TX_MAX_EVENTS": str(args.max_events),
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    def run_capture(nvram_directory: pathlib.Path | None = None):
        # This tool passed a SHARED -state_directory as well as a shared
        # -cfg_directory. Both are the trap-12 shape; the launcher gives each
        # run its own of each, and the bound is unchanged.
        with mame_launch(mame=mame, rompath=rompath, frames=last_frame,
                         autoboot=script,
                         extra=("-debug", "-debugger", "none", "-nothrottle"),
                         nvram_directory=nvram_directory) as launch:
            with log.open("w", encoding="utf-8") as handle:
                completed = run_mame(launch.argv, env=environment, stdout=handle,
                                     stderr=-2, timeout=args.timeout)
            return completed, log.read_text(encoding="utf-8", errors="replace")

    nvram_record: dict[str, object] = {"mode": "fresh-per-run"}
    if args.nvram_seed is None:
        completed, text = run_capture()
    else:
        seed = args.nvram_seed.resolve()
        if not seed.is_dir() or not (seed / "stunrun").is_dir():
            parser.error("--nvram-seed must be a NVRAM root containing stunrun/")
        with tempfile.TemporaryDirectory(prefix="stunrun-adsp-nvram-",
                                         dir=os.environ.get("TMPDIR")) as temporary:
            staged_nvram = pathlib.Path(temporary)
            shutil.copytree(seed, staged_nvram, dirs_exist_ok=True)
            initial_files = directory_hashes(staged_nvram)
            completed, text = run_capture(staged_nvram)
            final_files = directory_hashes(staged_nvram)
        nvram_record = {
            "mode": "seeded-copy",
            "seed_source": str(seed),
            "initial_files_sha256": initial_files,
            "final_files_sha256": final_files,
        }
    lua_errors = find_lua_errors(text)
    check_lua_errors(text, log)
    done = DONE.findall(text)
    if completed.returncode or not done:
        raise SystemExit(f"transaction capture did not complete; see {log}")
    _, event_count, truncated_text, bank_event_count, tx_start_frame, tx_start_seq, \
        tx_end_frame, tx_end_seq, record_count = done[-1]
    if truncated_text == "true":
        raise SystemExit(f"event cap reached ({args.max_events}); capture is incomplete: {log}")
    if "nil" in (tx_start_frame, tx_start_seq, tx_end_frame, tx_end_seq):
        raise SystemExit(f"no complete SOMCLK->GINT transaction; see {log}")
    start_seq, end_seq = int(tx_start_seq), int(tx_end_seq)

    events = [parse_event(m) for m in EVENT.finditer(text)]
    pm_reads = [e for e in events if e["cpu"] == "adsp_program" and
                start_seq <= int(e["seq"]) <= end_seq and
                0x0147 <= int(e["pc"]) <= 0x0173]
    if any(e["access"] != "R" or not 0x1000 <= int(e["address"]) <= 0x1fff
           for e in pm_reads):
        raise SystemExit("ADSP PM tap emitted an out-of-window or non-read event")
    record_states = []
    for m in STATE.finditer(text):
        base = int(m.group(7), 16)
        words = [int(w, 16) for w in m.group(9).split(",")]
        # The Lua header prints the inclusive last address, so the window is
        # [base, limit]; an unversioned struct dump read against a different
        # window would otherwise invent plausible geometry instead of failing.
        expected = int(m.group(8), 16) - base + 1
        if len(words) != expected:
            raise SystemExit(
                f"record {m.group(1)}: DM window {base:04X}..{int(m.group(8), 16):04X} "
                f"is {expected} words but {len(words)} were captured")
        record_states.append({
            "record": int(m.group(1)),
            "frame": int(m.group(2)),
            "i1": int(m.group(3)), "i2": int(m.group(4)),
            "m1": int(m.group(5)), "m2": int(m.group(6)),
            "dm_base": base, "dm_limit": base + len(words),
            "dm_words": words,
        })
    if len(record_states) != int(record_count):
        raise SystemExit(
            f"record state count mismatch: {len(record_states)} captured, "
            f"{record_count} reported")
    banks = [{"seq": int(m.group(1)), "frame": int(m.group(2)),
              "address": int(m.group(3), 16), "offset": int(m.group(4), 16),
              "bank": int(m.group(5)), "pc": int(m.group(6), 16)}
             for m in BANK.finditer(text)]
    if len(events) != int(event_count) or len(banks) != int(bank_event_count):
        raise SystemExit(
            f"event count mismatch: event lines={len(events)}/{event_count}, "
            f"bank lines={len(banks)}/{bank_event_count}; refusing partial result")

    adsp_writes = [e for e in events if e["cpu"] == "adsp" and e["access"] == "W"]
    somclk = [e for e in adsp_writes if e["address"] == 0x2003 and
              e["seq"] == int(tx_start_seq)]
    gint = [e for e in adsp_writes if e["address"] == 0x2006 and
            e["seq"] == int(tx_end_seq)]
    if len(somclk) != 1 or len(gint) != 1 or somclk[0]["seq"] >= gint[0]["seq"]:
        raise SystemExit(
            "expected a completed SOMCLK->GINT transaction; "
            f"found SOMCLK={len(somclk)} GINT={len(gint)}. See {log}")
    start_seq, end_seq = int(somclk[0]["seq"]), int(gint[0]["seq"])
    som_writes = [e for e in adsp_writes if e["address"] == 0x2002 and
                  start_seq < int(e["seq"]) < end_seq]
    if not som_writes:
        raise SystemExit("SOMCLK->GINT interval contains no SOMLATCH output words")

    bank_before = int(somclk[0]["host_bank"])
    som_start = int(somclk[0]["data"]) & 0x1fff
    transaction_frame = int(somclk[0]["frame"])
    related_irq_acks = [e for e in events if e["cpu"] == "maincpu" and
                        e["access"] == "W" and
                        0x818060 <= int(e["address"]) <= 0x81807f and
                        e["frame"] == transaction_frame and
                        int(e["seq"]) > end_seq]
    transaction = {
        "frame": transaction_frame,
        "somclk": somclk[0],
        "gint": gint[0],
        "host_bank": bank_before,
        "adsp_producer_bank": bank_before ^ 1,
        "som_start_word": som_start,
        "som_words": [
            {"address_word": (som_start + i) & 0x1fff,
             "value": int(e["data"]), "pc": int(e["pc"]), "seq": int(e["seq"])}
            for i, e in enumerate(som_writes)
        ],
        "producer_events": [e for e in events if e["cpu"] == "adsp" and
                            start_seq <= int(e["seq"]) <= end_seq],
        # PM program-space reads were already tapped in Lua but previously
        # dropped from the parsed transaction. Preserve exact same-run operands.
        "pm_reads": pm_reads,
        "maincpu_irq_acks": related_irq_acks,
        # Ferry events occur after the GINT and can include unrelated traffic
        # during the post-frame window. Keep counts and small samples without
        # falsely attributing every host transfer to this SOM block.
        "post_window_ferry_observation": {
            "som_buffer_read_count": sum(1 for e in events
                if e["cpu"] == "maincpu" and e["access"] == "R" and
                0x810000 <= int(e["address"]) <= 0x813fff),
            "hstdat_write_count": sum(1 for e in events
                if e["cpu"] == "maincpu" and e["access"] == "W" and
                0x00c0000c <= int(e["address"]) <= 0x00c0000f),
            "transaction_correlation": "not established by this capture",
        },
    }
    rom_manifest_sha256 = sha256(manifest)
    mame_sha256 = sha256(mame)
    result = {
        "schema": "stunrun-adsp-som-transaction/v1",
        "input": "none",
        "start_condition": "power_on",
        "devices": {"adsp": ":mainpcb:adsp", "maincpu": ":mainpcb:maincpu"},
        "transaction_start_frame": int(tx_start_frame),
        "transaction_end_frame": int(tx_end_frame),
        "capture_window": [args.start_frame, last_frame],
        "rom_manifest": str(manifest),
        "rom_manifest_sha256": rom_manifest_sha256,
        "machine_map": str(pathlib.Path(__file__).resolve().parents[1] /
                            "analysis/driver-mining/stunrun.machine-map.yaml"),
        "machine_map_sha256": sha256(pathlib.Path(__file__).resolve().parents[1] /
                                      "analysis/driver-mining/stunrun.machine-map.yaml"),
        "mame_binary": str(mame),
        "mame_binary_sha256": mame_sha256,
        "nvram": nvram_record,
        "harness": "tools/capture-adsp-som-transaction + mame/lua/adsp-som-transaction.lua",
        "harness_sha256": {"python": sha256(pathlib.Path(__file__).resolve()),
                           "lua": sha256(script)},
        "register_snapshots": "ADSP AR/AF/AX/AY/MY/MR/SR/SI/SE/I/M/L at PC 0x0570-0x0580 and 0x05DD-0x0630; same-run PM program-space reads for PC 0x0147-0x0173 are retained in transaction.pm_reads",
        "max_events": args.max_events,
        "truncated": False,
        "bank_events": banks,
        "record_states": record_states,
        "transaction": transaction,
        "lua_errors": lua_errors,
    }
    canonical = json.dumps(transaction, sort_keys=True, separators=(",", ":")).encode()
    result["transaction_sha256"] = hashlib.sha256(canonical).hexdigest()
    result_path = args.output / "result.json"
    result_path.write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    print(json.dumps({"schema": result["schema"], "frame": transaction["frame"],
                      "som_words": len(som_writes), "gint_pc": gint[0]["pc"],
                      "host_bank": bank_before, "producer_bank": bank_before ^ 1,
                      "pm_reads": len(transaction["pm_reads"]),
                      "transaction_sha256": result["transaction_sha256"]}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
