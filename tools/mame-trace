#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: $0 ROMPATH OUTPUT_DIRECTORY CPU_TAG [FRAMES] [MAME_EXE] [INPUT] [TRACE_START_FRAME] [--load-state STATE | --playback INP]" >&2
    exit 2
}

[[ $# -ge 3 && $# -le 9 ]] || usage
rompath=$1
output=$2
cpu=$3
frames=${4:-60}
mame_exe=${5:-mame}
input_mode=${6:-none}
trace_start_frame=${7:-1}
load_state=
playback=
if [[ $# -gt 7 ]]; then
    [[ $# -eq 9 && ( $8 == "--load-state" || $8 == "--playback" ) ]] || usage
    if [[ $8 == "--load-state" ]]; then
        load_state=$9
        [[ -f "$load_state" ]] || { echo "save state does not exist: $load_state" >&2; exit 2; }
    else
        playback=$9
        [[ -f "$playback" ]] || { echo "input recording does not exist: $playback" >&2; exit 2; }
        [[ "$input_mode" == "none" ]] || { echo "--playback requires INPUT=none" >&2; exit 2; }
    fi
fi
[[ "$frames" =~ ^[1-9][0-9]*$ ]] || { echo "frames must be a positive integer" >&2; exit 2; }
[[ "$trace_start_frame" =~ ^[1-9][0-9]*$ && "$trace_start_frame" -le "$frames" ]] || { echo "trace start frame must be in 1..frames" >&2; exit 2; }
[[ "$input_mode" == "none" || "$input_mode" == "coin_start" || "$input_mode" == "coin2_start" || "$input_mode" == "coin2_early" || "$input_mode" == "service" || "$input_mode" == "service_f2" || "$input_mode" == "sw_off" || "$input_mode" == "sw_off_none" || "$input_mode" == "drive" || "$input_mode" == "late" || "$input_mode" == "late_drive" || "$input_mode" == "fork_hold_left" || "$input_mode" == "fork_center" ]] || { echo "unsupported input mode: $input_mode" >&2; exit 2; }
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
mkdir -p "$output"

case "$cpu" in
    :mainpcb:maincpu) id=maincpu-68010 ;;
    :mainpcb:gsp) id=gsp-tms34010 ;;
    :mainpcb:adsp) id=adsp2100 ;;
    :mainpcb:jsa:cpu) id=sound-6502 ;;
    *) echo "unsupported active CPU tag: $cpu" >&2; exit 2 ;;
esac

trace="$output/$id.trace"
# The MAME invocation goes through tools/mame_launch.py so this shell wrapper
# cannot be the place an isolation flag is spelled a seventh way. The wrapper
# has no Python of its own, so it calls python3 once. cfg/nvram/state get a
# fresh per-run directory from the launcher, which is what stops one run reading
# the previous run's stunrun.cfg (AGENTS.md trap 12); the staged load-state
# directory stays caller-owned and is removed by the EXIT trap below.
#
# `seconds_to_run` keeps this tool's own bound, $(( (frames + 59) / 60 + 1 )),
# which equals mame_launch.seconds_for_frames(frames): bash integer division
# floors exactly as Python's // does, and the max(2, ...) clamp is redundant
# for frames >= 1. With --load-state it is 86400, because the observers count
# RELATIVE frames and a pre-advanced state needs an effectively unbounded run.
state_directory=
seconds_to_run=$(( (frames + 59) / 60 + 1 ))
if [[ -n "$load_state" ]]; then
    state_directory=$(mktemp -d /tmp/stunrun-trace-state.XXXXXX)
    mkdir -p "$state_directory/stunrun"
    cp "$load_state" "$state_directory/stunrun/1.sta"
    cleanup_state() {
        rm -f "$state_directory/stunrun/1.sta"
        rmdir "$state_directory/stunrun" "$state_directory" 2>/dev/null || true
    }
    trap cleanup_state EXIT
    seconds_to_run=86400
fi
STUNRUN_TRACE_OUT="$trace" \
STUNRUN_TRACE_CPU="$cpu" \
STUNRUN_TRACE_FRAMES="$frames" \
STUNRUN_TRACE_INPUT="$input_mode" \
STUNRUN_TRACE_START_FRAME="$trace_start_frame" \
STUNRUN_TRACE_PLAYBACK="$playback" \
SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-dummy}" \
python3 - "$repo_dir" "$rompath" "$mame_exe" "$seconds_to_run" "$state_directory" \
         "$playback" "$output/mame.log" <<'PY'
import pathlib
import subprocess
import sys

sys.path.insert(0, sys.argv[1])
sys.path.insert(0, str(pathlib.Path(sys.argv[1]) / "tools"))
from mame_launch import mame_launch
from mame_harness.process import run_mame

repo_dir, rompath, mame_exe = sys.argv[1], sys.argv[2], sys.argv[3]
seconds = int(sys.argv[4])
state_directory = sys.argv[5] or None
playback = pathlib.Path(sys.argv[6]).resolve() if sys.argv[6] else None
log_path = pathlib.Path(sys.argv[7])

# run_mame does not raise on a nonzero exit; `set -e` used to abort on one
# directly, so the code is passed out explicitly or a dead emulator reads as a
# clean run.
with mame_launch(mame=mame_exe, rompath=rompath, seconds=seconds,
                 state_directory=state_directory,
                 playback=playback,
                 autoboot=pathlib.Path(repo_dir) / "mame" / "lua" / "trace.lua",
                 extra=("-debug", "-debugger", "none") +
                       (("-state", "1") if state_directory else ())) as launch:
    with log_path.open("w", encoding="utf-8") as handle:
        status = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT)
sys.exit(status.returncode)
PY

# MAME reports a failed `-autoboot_script` as a line in its own output and then
# carries on, exiting 0. A trace that stopped collecting therefore looks like a
# CPU that never executed the requested window. The decision itself belongs to
# every wrapper, so it lives in mame_harness/process.py; this shell wrapper has
# no Python of its own and calls it once, recording the errors in result.json
# before the check so the diagnosis has an artifact to point at.
python3 - "$repo_dir" "$output/mame.log" "$output/result.json" "$trace" "$cpu" \
    "$frames" "$input_mode" "$trace_start_frame" <<'PY'
import json
import pathlib
import sys

sys.path.insert(0, sys.argv[1])
from mame_harness.process import check_lua_errors, find_lua_errors

log = pathlib.Path(sys.argv[2])
text = log.read_text(encoding="utf-8", errors="replace")
lua_errors = find_lua_errors(text)
pathlib.Path(sys.argv[3]).write_text(json.dumps({
    "schema": "stunrun-trace-result/v1",
    "trace": sys.argv[4],
    "cpu": sys.argv[5],
    "frames": int(sys.argv[6]),
    "input": sys.argv[7],
    "trace_start_frame": int(sys.argv[8]),
    "lua_errors": lua_errors,
}, indent=2) + "\n", encoding="utf-8")
check_lua_errors(text, log)
PY

[[ -e "$trace" ]] || { echo "trace was not produced: $trace" >&2; exit 1; }
if [[ ! -s "$trace" ]]; then
    echo "trace is empty for the requested bounded window: $trace" >&2
fi
printf '%s\n' "$trace"
