#!/usr/bin/env python3
"""Check that a committed oracle fixture is the thing its name claims.

Two traps, both of which have already been committed here at least once.

TRAP 1 -- it might not be the device at all.
fixtures/oracle/frame_600/frame_600_gsp_vram.bin was committed at 1048576 bytes,
under a VRAM name, with no provenance. It is not VRAM: its first two words are the
MC68010's reset stack pointer and reset PC (ffffc000 00000216), which live in main
CPU RAM at address 0. Nothing failed, because nothing read the file -- no CTest and
no python test referenced fixtures/oracle/, so a mislabelled blob sat in the tree
with a green suite behind it. A fixture nobody checks is a comment with a checksum.

TRAP 2 -- the size may be right while the units are wrong, and this checker is
the reason to care about that.
The same fixture was later replaced by a 4194304-byte file, captured by reading
GSP program addresses 0xff800000-0xffffffff. That is 4 MiB of *bit*-address span.
The share behind it is 512 KiB: SP-338 page 10 labels the silicon 'VRAM Array (16)
64K x 4' (16 x 256 Kbit = 4 Mbit = 512 KiB) and MAME's own memory_share reports
share bytes=524288. The program space is configured datawidth 16, addrshift 3, so
one program-space address unit is one BIT:

    byte_offset = ((addr - 0xFF800000) >> 3) & 0x7FFFF

So a host HSTADR of $FF896040 lands at physical byte $12C08, not $96040. Sizing a
"VRAM capture" from the address range instead of from the share gets a file 8x
too large that still looks like a successful capture. See
docs/mc68010-boot-findings.md section 34.

That is why the expected size here is 524288 and not 4194304, and why the
reset-vector check is not enough on its own.

Provenance is checked against metadata.json rather than trusted: the fixture's
sha256 must be the one the metadata records, and the metadata must name the
command that produced it. An unrecorded blob has no business being an oracle.

Exit 0 if the fixture is sound, 1 if it is not, with the reason on stderr.
"""

import argparse
import hashlib
import json
import pathlib
import sys

SCHEMA = "stunrun-oracle-fixture/v1"

# The physical GSP VRAM share. SP-338 page 10: 'VRAM Array (16) 64K x 4' =
# 16 x 256 Kbit = 512 KiB. MAME's memory_share independently reports the same:
#   share bytes=524288 words=262144 vram_mask=0x003ffff
# NOT 4 MiB. A 4 MiB capture of GSP program addresses is 8x too large and spans
# bit addresses, not physical bytes -- see the docstring.
GSP_VRAM_BYTES = 0x80000

# The MC68010's reset SP and PC, which live in main RAM at address 0 and must
# never appear at the start of a file claiming to be the GSP VRAM share.
M68K_RESET_VECTOR = bytes.fromhex("ffffc00000000216")


def check(path: pathlib.Path, meta_path: pathlib.Path, json_out, verify_sha: bool):
    problems = []

    if not path.is_file():
        print(f"{path}: missing", file=sys.stderr)
        return 1, {}
    blob = path.read_bytes()

    # --- size ------------------------------------------------------------
    size_ok = len(blob) == GSP_VRAM_BYTES
    if not size_ok:
        problems.append(
            f"size {len(blob)} != {GSP_VRAM_BYTES} (the 512 KiB physical share); "
            f"4194304 bytes is 4 MiB of GSP bit-address span, not physical VRAM"
        )

    # --- not main RAM ----------------------------------------------------
    if blob[:8] == M68K_RESET_VECTOR:
        problems.append(
            "first 8 bytes are ffffc000 00000216: the MC68010 reset SP/PC, "
            "which live in main CPU RAM at address 0 -- this is not VRAM"
        )

    # --- provenance ------------------------------------------------------
    sha = hashlib.sha256(blob).hexdigest()
    meta = {}
    if not meta_path.is_file():
        problems.append(f"{meta_path}: missing; an oracle with no recorded "
                        f"provenance is how the previous fixture went wrong")
    else:
        try:
            meta = json.loads(meta_path.read_text())
        except json.JSONDecodeError as e:
            problems.append(f"{meta_path}: not valid JSON ({e})")
            meta = {}
        if meta:
            if meta.get("schema") != SCHEMA:
                problems.append(f"{meta_path}: schema is "
                                f"{meta.get('schema')!r}, expected {SCHEMA!r}")
            # The descriptor block may be called `artifact` (a generic fixture)
            # or `share` (a device share that has sub-parts). Accept either so
            # this checker is not tied to one fixture's naming.
            art = meta.get("artifact") or meta.get("share") or {}
            if art.get("bytes") != len(blob):
                problems.append(f"metadata size {art.get('bytes')!r} "
                                f"!= actual {len(blob)}")
            if verify_sha and art.get("sha256") and art["sha256"] != sha:
                problems.append(f"sha256 {sha} != metadata {art['sha256']}; "
                                f"the blob is not the one that was recorded")
            if not (meta.get("capture") or {}).get("command"):
                problems.append("metadata records no capture command")

    # --- not trivially empty ---------------------------------------------
    nonzero = sum(1 for b in blob if b)
    if nonzero == 0:
        problems.append("every byte is zero: a misconfigured read produces a "
                        "correctly sized file full of zeros that otherwise "
                        "looks like a successful capture")

    report = {
        "schema": "stunrun-oracle-fixture-check/v1",
        "path": str(path),
        "bytes": len(blob),
        "expected_bytes": GSP_VRAM_BYTES,
        "sha256": sha,
        "nonzero_bytes": nonzero,
        "is_gsp_vram_share": not blob[:8] == M68K_RESET_VECTOR,
        "provenance_recorded": bool(meta),
        "ok": not problems,
        "problems": problems,
    }

    if json_out:
        json_out.write_text(json.dumps(report, indent=2) + "\n")

    if problems:
        for p in problems:
            print(f"FAIL {path}: {p}", file=sys.stderr)
        return 1, report

    print(f"OK {path}: {len(blob)} bytes, sha256 {sha[:16]}..., "
          f"{nonzero} nonzero, provenance recorded")
    return 0, report


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("fixture", type=pathlib.Path,
                    help="path to the oracle fixture to check")
    ap.add_argument("--metadata", type=pathlib.Path, default=None,
                    help="provenance json (default: metadata.json beside it)")
    ap.add_argument("-o", "--json", type=pathlib.Path, default=None,
                    help="write a machine-readable report here")
    ap.add_argument("--no-verify-sha", action="store_true",
                    help="skip the sha256 comparison against metadata")
    a = ap.parse_args()

    meta = a.metadata or (a.fixture.parent / "metadata.json")
    rc, _ = check(a.fixture, meta, a.json, not a.no_verify_sha)
    return rc


if __name__ == "__main__":
    sys.exit(main())