#!/usr/bin/env python3
"""Diff the two shared-VRAM images taken either side of the GSP halt release.

What this question is, and the trap it exists to avoid
-----------------------------------------------------
``tools/capture-gsp-program-upload`` takes one image at the last frame edge with
the GSP still halted and one at the frame edge after the release. The tempting
mistake is to read the difference as "what the upload added", or to read either
image as "the GSP program". Neither is safe:

* the halted image already contains whatever ran during the earlier /GSPRES
  release at power-on, because /GSPRES goes released once before the upload and
  the board then parks the GSP with HSTCTL bit 15;
* the post-release image adds up to one whole frame of GSP execution, so the
  difference is the GSP's FIRST OUTPUT and nothing else -- not the upload, and
  not a steady-state behaviour.

So this tool reports the difference as an address-range census with word counts
and per-range samples, and refuses to guess what any of it means. It does not
name a format.

Both images are the whole 4 MiB share in little-endian word order, which is what
the native VRAM paths store, so a byte difference here is a word difference there.

Usage:

    tools/diff-gsp-upload-images BEFORE.bin AFTER.bin [--json out.json]
"""

import argparse
import hashlib
import json
import pathlib
import sys

SCHEMA = "stunrun-gsp-upload-image-diff/v1"

# Reports only, never interprets. Anything smaller than this is summarised as a
# count so the output stays readable when the GSP rewrites a large area.
MIN_RANGE_WORDS = 1


def load_words(path):
    data = path.read_bytes()
    if len(data) % 2:
        raise SystemExit(f"{path} is {len(data)} bytes, not a whole number of 16-bit words")
    words = []
    for index in range(0, len(data), 2):
        words.append(data[index] | (data[index + 1] << 8))
    return words


def ranges_of_offsets(offsets):
    """Group sorted word offsets into contiguous runs."""
    ranges = []
    start = previous = None
    for offset in offsets:
        if start is None:
            start = previous = offset
            continue
        if offset == previous + 1:
            previous = offset
            continue
        ranges.append((start, previous))
        start = previous = offset
    if start is not None:
        ranges.append((start, previous))
    return ranges


def summarize(before_path, after_path):
    before = load_words(before_path)
    after = load_words(after_path)
    if len(before) != len(after):
        raise SystemExit(
            f"images differ in size: {before_path} has {len(before)} words, "
            f"{after_path} has {len(after)}; they must be the same share")
    changed = []
    inserted = removed = modified = 0
    for index, (left, right) in enumerate(zip(before, after)):
        if left == right:
            continue
        changed.append(index)
        if left == 0:
            inserted += 1
        elif right == 0:
            removed += 1
        else:
            modified += 1
    ranges = []
    for start, end in ranges_of_offsets(changed):
        entry = {
            "first_word_offset": start,
            "last_word_offset": end,
            "word_count": end - start + 1,
            # The GSP's logical address is 8x the word's byte address, and the
            # share starts at 0xff800000; keep both so a reader does not have to
            # redo the arithmetic or guess which one a range refers to.
            "byte_offset_range": [start * 2, (end + 1) * 2],
            "logical_bit_address_range": [start * 16, (end + 1) * 16],
            "before_sample": [before[i] for i in
                              range(start, min(start + 4, end + 1))],
            "after_sample": [after[i] for i in
                             range(start, min(start + 4, end + 1))],
        }
        entry["vram_address_range"] = [0xFF800000 + start * 2,
                                       0xFF800000 + (end + 1) * 2]
        ranges.append(entry)
    return {
        "schema": SCHEMA,
        "before": {"path": str(before_path), "sha256": hashlib.sha256(
            before_path.read_bytes()).hexdigest(), "words": len(before)},
        "after": {"path": str(after_path), "sha256": hashlib.sha256(
            after_path.read_bytes()).hexdigest(), "words": len(after)},
        "share_base": 0xFF800000,
        "changed_words": len(changed),
        "unchanged_words": len(before) - len(changed),
        "words_newly_nonzero": inserted,
        "words_newly_zero": removed,
        "words_modified": modified,
        "changed_ranges": ranges,
        "changed_range_count": len(ranges),
        "interpretation_limits": {
            "meaning": "difference is up to one frame of GSP execution, not the upload",
            "before_image": "already contains whatever ran during the pre-upload /GSPRES release",
            "format": "not decoded; no field names are claimed",
        },
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("before", type=pathlib.Path)
    parser.add_argument("after", type=pathlib.Path)
    parser.add_argument("--json", type=pathlib.Path)
    args = parser.parse_args()
    for path in (args.before, args.after):
        if not path.is_file():
            raise SystemExit(f"missing image: {path}")
    summary = summarize(args.before, args.after)
    if args.json:
        args.json.write_text(json.dumps(summary, indent=2) + "\n", encoding="utf-8")
    printable = {key: value for key, value in summary.items()
                 if key != "changed_ranges"}
    printable["largest_ranges"] = sorted(
        summary["changed_ranges"], key=lambda entry: entry["word_count"],
        reverse=True)[:16]
    print(json.dumps(printable, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())