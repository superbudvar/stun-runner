#!/usr/bin/env python3
"""Probe execution of static 68010 landmark candidates for a bounded run."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors
from mame_launch import mame_launch


HIT = re.compile(r"M1_LANDMARK_HIT pc=([0-9A-Fa-f]+)")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("pcs", help="comma-separated 68010 PCs, e.g. 0xB228,0xBE6A")
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--input", choices=("none", "coin_start"), default="none")
    parser.add_argument("--debugger", choices=("none", "console"), default="none")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    environment = {
        "STUNRUN_LANDMARK_OUT": str(args.output),
        "STUNRUN_LANDMARK_FRAMES": str(args.frames),
        "STUNRUN_LANDMARK_PCS": args.pcs,
        "STUNRUN_LANDMARK_INPUT": args.input,
    }
    with mame_launch(mame=args.mame, rompath=args.rompath, frames=args.frames,
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/landmark-probe.lua",
                     extra=("-debug", "-debugger", args.debugger)) as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(launch.argv, stdout=handle, stderr=subprocess.STDOUT, env={**os.environ, **environment}, check=False)
        text = log.read_text(encoding="utf-8")
    hits = [int(match.group(1), 16) for match in HIT.finditer(text)]
    canonical = re.sub(r"output=[^\n]+", "output=<output>", text)
    lua_errors = find_lua_errors(text)
    result = {
        "schema": "stunrun-landmark-probe-result/v1",
        "pcs": [int(value, 0) for value in args.pcs.split(",")],
        "frames": args.frames,
        "input": args.input,
        "returncode": completed.returncode,
        "lua_errors": lua_errors,
        "hits": hits,
        "hit_counts": {f"0x{pc:06X}": hits.count(pc) for pc in sorted(set(hits))},
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    # A probe that never installed its execute taps reports no hits, which reads
    # as "this landmark never ran" rather than "we stopped watching".
    check_lua_errors(text, log)
    if completed.returncode:
        raise SystemExit(f"MAME failed; see {log}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
