#!/usr/bin/env python3
"""Capture bounded MAME watchpoints at the JSA command/response boundary."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors
from mame_launch import mame_launch


EVENT = re.compile(
    r"M1_SOUND_(READ|WRITE) label=([a-z_]+) frame=(\d+) pc=([0-9A-Fa-f]+) "
    r"addr=([0-9A-Fa-f]+) data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--input", choices=("none", "coin_start"), default="none")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    environment = {
        "STUNRUN_SOUND_BOUNDARY_FRAMES": str(args.frames),
        "STUNRUN_SOUND_BOUNDARY_INPUT": args.input,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    with mame_launch(mame=args.mame, rompath=args.rompath, frames=args.frames,
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/sound-boundary.lua",
                     extra=("-debug", "-debugger", "none")) as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = subprocess.run(
                launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                env={**os.environ, **environment}, check=False,
            )
        text = log.read_text(encoding="utf-8")
    events = [
        {"direction": match.group(1).lower(), "label": match.group(2),
         "frame": int(match.group(3)), "pc": int(match.group(4), 16),
         "address": int(match.group(5), 16), "data": int(match.group(6), 16),
         "mask": int(match.group(7), 16)}
        for match in EVENT.finditer(text)
    ]
    canonical = re.sub(r"M1_SOUND_BOUNDARY_DONE frames=\d+", "M1_SOUND_BOUNDARY_DONE frames=<frames>", text)
    lua_errors = find_lua_errors(text)
    result = {
        "schema": "stunrun-sound-boundary-result/v1",
        "frames": args.frames,
        "input": args.input,
        "returncode": completed.returncode,
        "lua_errors": lua_errors,
        "events": len(events),
        "event_counts": {
            label: sum(event["label"] == label for event in events)
            for label in (
                "main_command", "main_response", "sound_command", "sound_response",
                "sound_rdio", "sound_irq_ack", "sound_oki", "sound_voice",
                "sound_wrio", "sound_mix", "sound_other",
            )
        },
        "first_events": events[:32],
        "last_events": events[-32:],
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    # This tool has no DONE-marker check, so a script that threw before its
    # taps were installed would otherwise exit 0 with `events: 0` -- an absent
    # observation that reads as a fact about the sound board.
    check_lua_errors(text, log)
    if completed.returncode:
        raise SystemExit(f"MAME failed; see {log}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
