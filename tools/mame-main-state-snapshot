#!/usr/bin/env python3
"""Capture direct reads from the input-adjacent 68010 RAM at frame landmarks."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors
from mame_launch import mame_launch


SNAPSHOT = re.compile(
    r"M1_MAIN_STATE frame=(\d+) pc=([0-9A-Fa-f]+) r=([0-9A-Fa-f]+) "
    r"aux=([0-9A-Fa-f]+) counter=([0-9A-Fa-f]+) flag=([0-9A-Fa-f]+)"
)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=1800)
    parser.add_argument("--targets", default="600,750,900,1200,1800")
    parser.add_argument("--input", choices=("none", "late", "late_drive"), default="late")
    parser.add_argument("--mame", default="mame")
    parser.add_argument("--load-state", type=pathlib.Path,
                        help="load a MAME state before starting the relative frame counter")
    parser.add_argument("--nothrottle", action="store_true",
                        help="run MAME as fast as possible while preserving emulated frame numbers")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    state_stage = None
    if args.load_state:
        if not args.load_state.is_file():
            raise SystemExit(f"save state does not exist: {args.load_state}")
        state_stage = pathlib.Path(tempfile.mkdtemp(prefix="stunrun-main-state-fork-"))
        slot_directory = state_stage / "stunrun"
        slot_directory.mkdir()
        shutil.copy2(args.load_state, slot_directory / "1.sta")
    extra: list[str] = []
    if args.load_state:
        extra += ["-state", "1"]
    if args.nothrottle:
        extra.append("-nothrottle")
    environment = {
        **os.environ,
        "STUNRUN_MAIN_STATE_OUT": str(args.output),
        "STUNRUN_MAIN_STATE_FRAMES": str(args.frames),
        "STUNRUN_MAIN_STATE_TARGETS": args.targets,
        "STUNRUN_MAIN_STATE_INPUT": args.input,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    try:
        # state_stage is caller-owned and removed below; with no --load-state
        # the launcher makes a fresh per-run directory rather than the shared
        # /tmp/stunrun-state-dir this tool used to pass.
        with mame_launch(mame=args.mame, rompath=args.rompath,
                         seconds=86400 if args.load_state else None,
                         frames=args.frames,
                         state_directory=state_stage,
                         autoboot=pathlib.Path(__file__).resolve().parents[1]
                         / "mame/lua/main-state-snapshot.lua",
                         extra=tuple(extra)) as launch:
            with log.open("w", encoding="utf-8") as handle:
                completed = subprocess.run(launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                                           env=environment, check=False)
            text = log.read_text(encoding="utf-8")
    finally:
        if state_stage is not None:
            shutil.rmtree(state_stage, ignore_errors=True)
    snapshots = [
        {"frame": int(match.group(1)), "pc": int(match.group(2), 16),
         "record": [int(match.group(3)[i:i + 2], 16) for i in range(0, 8, 2)],
         "record_aux": [int(match.group(4)[i:i + 2], 16) for i in range(0, 8, 2)],
         "queue_counter": int(match.group(5), 16), "update_flag": int(match.group(6), 16)}
        for match in SNAPSHOT.finditer(text)
    ]
    canonical = re.sub(r"output=[^\n]+", "output=<output>", text)
    lua_errors = find_lua_errors(text)
    result = {
        "schema": "stunrun-main-state-snapshot-result/v1",
        "frames": args.frames, "targets": args.targets, "input": args.input,
        "load_state": str(args.load_state) if args.load_state else None,
        "nothrottle": args.nothrottle,
        "returncode": completed.returncode, "lua_errors": lua_errors,
        "snapshots": snapshots,
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode or len(snapshots) != len(args.targets.split(',')):
        raise SystemExit(f"main state snapshot failed; see {log}")
    check_lua_errors(text, log)
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
