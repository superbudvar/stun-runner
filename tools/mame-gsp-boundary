#!/usr/bin/env python3
"""Capture bounded 68010 writes to the observed GSP FIFO sink."""

import argparse
import hashlib
import json
import os
import pathlib
import re
import sys
import subprocess

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors, run_mame
from mame_launch import mame_launch


FIRST = re.compile(
    r"M1_GSP_WRITE_FIRST frame=(\d+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+) post_init=(true|false)"
)
COMMAND_FIRST = re.compile(
    r"M1_GSP_COMMAND_FIRST frame=(\d+) pc=([0-9A-Fa-f]+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+) post_init=(true|false)"
)
EXECUTION_FIRST = re.compile(r"M1_GSP_EXEC_FIRST frame=(\d+) pc=([0-9A-Fa-f]+)")
EXECUTE_TAP_STATUS = re.compile(r"M1_GSP_EXECUTE_TAP_STATUS status=([a-z-]+)")
PC_SAMPLE = re.compile(r"M1_GSP_PC_SAMPLE frame=(\d+) pc=([0-9A-Fa-f]+)")
RESET_WRITE = re.compile(
    r"M1_GSP_RESET_WRITE frame=(\d+) addr=([0-9A-Fa-f]+) "
    r"data=([0-9A-Fa-f]+) mask=([0-9A-Fa-f]+)"
)


def observer_missing(tap_status, execution_landmarks):
    """True when `execution_landmarks` is empty for lack of an observer.

    The landmark list is the only evidence here that the GSP itself ran. An
    empty list means "not observed" only when the tap was actually installed;
    otherwise it means the observer never started, and publishing it would turn
    our own failure into a claim about the hardware.
    """
    return tap_status != "observed" and not execution_landmarks


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("rompath", type=pathlib.Path)
    parser.add_argument("output", type=pathlib.Path)
    parser.add_argument("--frames", type=int, default=600)
    parser.add_argument("--capture-start-frame", type=int, default=132)
    parser.add_argument("--input", choices=("none", "coin_start", "sw_off", "sw_off_prestart", "sw_off_none", "drive"), default="none")
    parser.add_argument("--mame", default="mame")
    args = parser.parse_args()
    if args.frames <= 0:
        parser.error("--frames must be positive")
    args.output.mkdir(parents=True, exist_ok=True)
    log = args.output / "mame.log"
    environment = {
        "STUNRUN_GSP_BOUNDARY_OUT": str(args.output),
        "STUNRUN_GSP_BOUNDARY_FRAMES": str(args.frames),
        "STUNRUN_GSP_BOUNDARY_CAPTURE_START": str(args.capture_start_frame),
        "STUNRUN_GSP_BOUNDARY_INPUT": args.input,
        "SDL_VIDEODRIVER": os.environ.get("SDL_VIDEODRIVER", "dummy"),
    }
    with mame_launch(mame=args.mame, rompath=args.rompath, frames=args.frames,
                     autoboot=pathlib.Path(__file__).resolve().parents[1]
                     / "mame/lua/gsp-boundary.lua",
                     extra=("-debug", "-debugger", "none")) as launch:
        with log.open("w", encoding="utf-8") as handle:
            completed = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT,
                                 env={**os.environ, **environment},
                                 timeout=max(30, args.frames / 10 + 30))
        text = log.read_text(encoding="utf-8")
    first = [
        {"frame": int(m.group(1)), "pc": int(m.group(2), 16),
         "address": int(m.group(3), 16), "data": int(m.group(4), 16),
         "mask": int(m.group(5), 16), "post_init": m.group(6) == "true"}
        for m in FIRST.finditer(text)
    ]
    command_first = [
        {"frame": int(m.group(1)), "pc": int(m.group(2), 16),
         "address": int(m.group(3), 16), "data": int(m.group(4), 16),
         "mask": int(m.group(5), 16), "post_init": m.group(6) == "true"}
        for m in COMMAND_FIRST.finditer(text)
    ]
    execution_first = [
        {"frame": int(m.group(1)), "pc": int(m.group(2), 16)}
        for m in EXECUTION_FIRST.finditer(text)
    ]
    gsp_pc_samples = [
        {"frame": int(m.group(1)), "pc": int(m.group(2), 16)}
        for m in PC_SAMPLE.finditer(text)
    ]
    reset_writes = [
        {"frame": int(m.group(1)), "address": int(m.group(2), 16),
         "data": int(m.group(3), 16), "mask": int(m.group(4), 16)}
        for m in RESET_WRITE.finditer(text)
    ]
    canonical = re.sub(r"output=[^\n]+", "output=<output>", text)
    lua_errors = find_lua_errors(text)
    tap_status = EXECUTE_TAP_STATUS.findall(text)
    result = {
        "schema": "stunrun-gsp-boundary-result/v1",
        "experiment": "gsp_boundary",
        "window": "0xc0000c-0xc0000f",
        "capture_start_frame": args.capture_start_frame,
        "frames": args.frames,
        "input": args.input,
        "returncode": completed.returncode,
        "lua_errors": lua_errors,
        "gsp_execute_tap_status": tap_status[-1] if tap_status else "unknown",
        "first_writes": first,
        "first_command_writes": command_first,
        "distinct_first_pcs": sorted({row["pc"] for row in first}),
        "distinct_command_pcs": sorted({row["pc"] for row in command_first}),
        "post_init_first_writes": sum(1 for row in first if row["post_init"]),
        "execution_landmarks": execution_first,
        "gsp_pc_samples": gsp_pc_samples,
        "reset_writes": reset_writes,
        "canonical_log_sha256": hashlib.sha256(canonical.encode("utf-8")).hexdigest(),
    }
    (args.output / "result.json").write_text(json.dumps(result, indent=2) + "\n", encoding="utf-8")
    if completed.returncode:
        raise SystemExit(f"MAME failed; see {log}")
    check_lua_errors(text, log)
    # `execution_landmarks` is the only evidence here that the GSP itself ran.
    if observer_missing(result["gsp_execute_tap_status"], execution_first):
        raise SystemExit(
            "no GSP execute tap was installed (status="
            f"{result['gsp_execute_tap_status']}), so execution_landmarks is "
            f"empty for lack of an observer rather than for lack of execution; "
            f"see {log}")
    print(json.dumps(result, separators=(",", ":")))


if __name__ == "__main__":
    main()
