#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "usage: $0 ROMPATH OUTPUT_DIRECTORY [MAME_EXE]" >&2
    exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage
rompath=$1
output=$2
mame_exe=${3:-mame}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
mkdir -p "$output"

# The MAME invocation goes through tools/mame_launch.py so this shell wrapper
# cannot be the place an isolation flag is spelled a seventh way. The wrapper
# has no Python of its own, so it calls python3 once and reads the log back
# below; the cfg/nvram/state directories are per-run and removed by the
# launcher, which is what stops one run reading the previous run's
# stunrun.cfg (AGENTS.md trap 12). The stdout of MAME stays in the log exactly
# as before, so the lua_errors line below is unchanged.
STUNRUN_LISTING_DIR="$output" python3 - "$repo_dir" "$rompath" "$output" "$mame_exe" <<'PY'
import pathlib
import subprocess
import sys

sys.path.insert(0, sys.argv[1])
sys.path.insert(0, str(pathlib.Path(sys.argv[1]) / "tools"))
from mame_launch import mame_launch
from mame_harness.process import run_mame

rompath, output, mame_exe = sys.argv[2], sys.argv[3], sys.argv[4]
# -seconds_to_run 2 is this tool's own bound: listings.lua disassembles and
# calls machine:exit() immediately, and two seconds covers a cold MAME start.
with mame_launch(mame=mame_exe, rompath=rompath, seconds=2,
                 autoboot=pathlib.Path(sys.argv[1]) / "mame" / "lua" / "listings.lua",
                 extra=("-debug", "-debugger", "none")) as launch:
    with (pathlib.Path(output) / "mame.log").open("w", encoding="utf-8") as handle:
        status = run_mame(launch.argv, stdout=handle, stderr=subprocess.STDOUT)
# `set -e` used to abort on a nonzero MAME exit. run_mame does not raise, so the
# code is passed out explicitly or a dead emulator reads as a clean run.
sys.exit(status.returncode)
PY

for listing in maincpu-68010 gsp-tms34010 adsp2100 sound-6502; do
    file="$output/$listing.lst"
    [[ -s "$file" ]] || { echo "missing listing: $file" >&2; exit 1; }
done

# MAME reports a failed `-autoboot_script` as a line in its own output and then
# carries on, exiting 0, so the exit status above never sees it. Every listing
# existing is therefore not by itself proof the script ran to completion: a
# script that threw after its last `dasm` leaves four perfectly decodable
# listings behind. The decision belongs to every wrapper and lives in
# mame_harness/process.py; this shell wrapper has no Python of its own and calls
# it once, after the listing files exist so the diagnosis has them to point at.
python3 - "$repo_dir" "$output/mame.log" <<'PY'
import json
import pathlib
import sys

sys.path.insert(0, sys.argv[1])
from mame_harness.process import check_lua_errors, find_lua_errors

log = pathlib.Path(sys.argv[2])
text = log.read_text(encoding="utf-8", errors="replace")
print("lua_errors: " + json.dumps(find_lua_errors(text)))
check_lua_errors(text, log)
PY

printf '%s\n' 'static listings generated:'
for listing in "$output"/*.lst; do
    printf '%s\n' "$listing"
done
