#!/usr/bin/env python3
"""Run an arcade-experiment/v1 file against the pinned MAME target."""

import argparse
import json
import math
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from mame_harness.process import check_lua_errors, find_lua_errors
from mame_launch import mame_launch


def lua_string(value: str) -> str:
    return json.dumps(value)


def lua_literal(value) -> str:
    if value is None:
        return "nil"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, str):
        return lua_string(value)
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, list):
        return "{" + ",".join(lua_literal(item) for item in value) + "}"
    if isinstance(value, dict):
        entries = []
        for key, item in value.items():
            entries.append(f"[{lua_string(key)}]={lua_literal(item)}")
        return "{" + ",".join(entries) + "}"
    raise TypeError(f"unsupported Lua value: {type(value)!r}")


def validate(experiment: dict) -> None:
    if experiment.get("schema") != "arcade-experiment/v1":
        raise ValueError("unsupported experiment schema")
    if not experiment.get("id") or not experiment.get("start"):
        raise ValueError("experiment requires id and start")
    initial_events = experiment.get("initial_events", [])
    if not isinstance(initial_events, list):
        raise ValueError("initial_events must be a list")
    expect = experiment.get("expect", {})
    if expect.get("kind") != "frame" or not isinstance(expect.get("frame"), int):
        raise ValueError("experiment expect must define a frame")
    for event in initial_events:
        if event.get("action") not in {"press", "release", "set"}:
            raise ValueError("unsupported initial input action")
        if event.get("action") == "set" and "value" not in event:
            raise ValueError("initial set events require value")
    last_frame = -1
    for event in experiment.get("events", []):
        if not isinstance(event.get("frame"), int) or event["frame"] < last_frame:
            raise ValueError("events must have nondecreasing non-negative frames")
        last_frame = event["frame"]
        if event.get("action") not in {"press", "release", "set"}:
            raise ValueError("unsupported input action")
        if event["action"] == "set" and "value" not in event:
            raise ValueError("set events require value")


def lua_script(experiment: dict, exact_snapshot: pathlib.Path | None = None) -> str:
    events = lua_literal(experiment.get("events", []))
    initial_events = lua_literal(experiment.get("initial_events", []))
    terminal = experiment["expect"]["frame"]
    exact_capture = ""
    if exact_snapshot is not None:
        exact_capture = f'''\n        machine.video:frame_update()\n        machine.video:snapshot()\n        machine:exit()'''
    return f'''local events = {events}
local initial_events = {initial_events}
local machine = manager.machine
local frame = 0
local next_event = 1
local captured = false

local function quote(value)
    value = tostring(value):gsub('\\\\', '\\\\\\\\'):gsub('"', '\\\\"')
    return '"' .. value .. '"'
end

local function json(value)
    if value == nil then return 'null' end
    if type(value) == 'string' then return quote(value) end
    if type(value) == 'number' or type(value) == 'boolean' then return tostring(value) end
    local parts = {{}}
    local keys = {{}}
    for key, _ in pairs(value) do keys[#keys + 1] = key end
    table.sort(keys)
    for _, key in ipairs(keys) do parts[#parts + 1] = quote(key) .. ':' .. json(value[key]) end
    return '{{' .. table.concat(parts, ',') .. '}}'
end

local function apply_event(event)
    local port = machine.ioport.ports[event.port]
    if port == nil then error('unknown input port: ' .. event.port) end
    local field = port.fields[event.field]
    if field == nil then error('unknown input field: ' .. event.port .. '/' .. event.field) end
    if event.action == 'press' then
        -- MAME's field API takes a logical active value; it applies the
        -- field's active-low polarity to the port representation.
        field:set_value(1)
    elseif event.action == 'release' then
        field:set_value(0)
    else
        field:set_value(event.value)
    end
    print('MAME_REPLAY_EVENT frame=' .. frame .. ' port=' .. event.port .. ' field=' .. event.field .. ' action=' .. event.action .. ' port_value=' .. string.format('%08X', port:read()))
end

emu.register_prestart(function()
    for _, event in ipairs(initial_events) do
        apply_event(event)
    end
end)

emu.register_frame_done(function()
    while next_event <= #events and events[next_event].frame == frame do
        apply_event(events[next_event])
        next_event = next_event + 1
    end
    if frame >= {terminal} and not captured then
        captured = true
        local result = {{schema='arcade-replay-result/v1', frame=frame, events_applied=next_event - 1, expected_events=#events}}
        print('MAME_REPLAY_JSON ' .. json(result))
        {exact_capture}
    end
    frame = frame + 1
end)
'''


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("experiment", type=pathlib.Path)
    parser.add_argument("--rompath", required=True, type=pathlib.Path)
    parser.add_argument("--mame", default="mame")
    parser.add_argument("--output", type=pathlib.Path, required=True)
    parser.add_argument("--exact-frame", action="store_true",
                        help="snapshot and stop on the experiment's expected frame")
    parser.add_argument("--nothrottle", action="store_true",
                        help="run MAME as fast as possible")
    parser.add_argument("--load-state", type=pathlib.Path,
                        help="load a MAME state before starting relative frames")
    args = parser.parse_args()
    experiment = json.loads(args.experiment.read_text(encoding="utf-8"))
    validate(experiment)
    if args.load_state:
        if not args.load_state.is_file():
            raise SystemExit(f"save state does not exist: {args.load_state}")
        if experiment.get("initial_events"):
            raise SystemExit(
                "initial_events cannot be used with --load-state; use relative events")
    args.output.mkdir(parents=True, exist_ok=True)
    # This tool's bound has always been max(2, ceil((frame + 1 or 120) / 60)),
    # which is NOT the shared seconds_for_frames. Preserved verbatim -- see
    # tools/mame_launch.py.
    seconds = (86400 if args.load_state else
               max(2, math.ceil((experiment["expect"]["frame"] +
                                 (1 if args.exact_frame else 120)) / 60)))

    with tempfile.TemporaryDirectory(prefix="stunrun-replay-") as temp_dir:
        script = pathlib.Path(temp_dir) / "replay.lua"
        log = pathlib.Path(temp_dir) / "mame.log"
        snapshot = args.output / f"{experiment['id']}-exact.png" if args.exact_frame else None
        script.write_text(lua_script(experiment, snapshot), encoding="utf-8")
        state_directory = None
        if args.load_state:
            state_directory = pathlib.Path(temp_dir) / "states"
            slot_directory = state_directory / "stunrun"
            slot_directory.mkdir(parents=True)
            shutil.copy2(args.load_state, slot_directory / "1.sta")
        environment = dict(os.environ)
        environment.setdefault("SDL_VIDEODRIVER", "dummy")
        # -video soft, not none: --exact-frame calls machine.video:snapshot()
        # and with no video driver there is nothing to render.
        extra: list[str] = ["-debug", "-debugger", "none"]
        if args.nothrottle:
            extra.append("-nothrottle")
        if args.load_state:
            extra += ["-state", "1"]
        with mame_launch(mame=args.mame, rompath=args.rompath, seconds=seconds,
                         state_directory=state_directory,
                         video="soft", autoboot=script,
                         extra=tuple(extra) + (
                             "-snapname", experiment["id"],
                             "-snapshot_directory", str(args.output))) as launch:
            with log.open("w", encoding="utf-8") as handle:
                completed = subprocess.run(launch.argv, stdout=handle, stderr=subprocess.STDOUT, check=False, env=environment)
            text = log.read_text(encoding="utf-8")
        published_log = args.output / "mame.log"
        published_log.write_text(text, encoding="utf-8")
        result_lines = [line.removeprefix("MAME_REPLAY_JSON ") for line in text.splitlines() if line.startswith("MAME_REPLAY_JSON ")]
        # The generated script is ours, so a throw in it is our own dead
        # observer: MAME prints `[LUA ERROR]`, carries on and exits 0, and a
        # result line printed before the throw would otherwise be published as
        # a complete replay of a run that stopped collecting. Record the errors
        # in both artifacts so the diagnosis survives whichever branch fires.
        lua_errors = find_lua_errors(text)
        if completed.returncode or not result_lines:
            failure = {
                "schema": "arcade-replay-failure/v1",
                "experiment": str(args.experiment),
                "returncode": completed.returncode,
                "reason": "mame_exit" if completed.returncode else "missing_result",
                "log": str(published_log),
                "load_state": str(args.load_state) if args.load_state else None,
                "lua_errors": lua_errors,
            }
            (args.output / "failure.json").write_text(json.dumps(failure, indent=2) + "\n", encoding="utf-8")
            raise SystemExit(f"replay failed; see {args.output / 'mame.log'}")
        result = json.loads(result_lines[-1])
        result["load_state"] = str(args.load_state) if args.load_state else None
        result["lua_errors"] = lua_errors
        (args.output / "result.json").write_text(
            json.dumps(result, separators=(",", ":")) + "\n", encoding="utf-8")
        check_lua_errors(text, published_log)
        # stdout stays MAME's own result line, verbatim: the artifacts in
        # reference/experiments are built from it.
        print(result_lines[-1])


if __name__ == "__main__":
    main()
